GEMINI_API_KEY=
RESEND_API_KEY=
SESSION_SECRET=

# Penyimpanan permanen lewat VERCEL BLOB - tempat akun admin, log
# aktivitas, override data/foto siswa, dan foto galeri disimpan permanen
# saat deploy di Vercel.
#
# Cara dapatnya (tidak perlu diisi manual):
#   1. Buka dashboard Vercel -> project ini -> tab Storage -> Create
#      Database -> pilih Blob -> Connect ke project ini.
#   2. Vercel otomatis menambahkan env var BLOB_READ_WRITE_TOKEN ke
#      project.
#   3. Redeploy project supaya env var-nya kepakai.
#
# PENTING: Blob di sini dipakai dengan mode "public" (foto galeri, foto
# siswa, dan JUGA data akun admin/log aktivitas semuanya tersimpan
# sebagai file public di Blob store ini). Jangan bagikan URL Blob store
# project ini ke orang lain, dan jangan set BLOB_BASE_PATH ke nilai yang
# gampang ditebak kalau tidak mau isinya berpotensi diakses orang lain.
#
# Tanpa BLOB_READ_WRITE_TOKEN, data yang ditambah lewat panel /admin
# TIDAK akan tersimpan permanen saat di-deploy di Vercel.
BLOB_READ_WRITE_TOKEN=

# Opsional (kalau tidak diisi, default "data-store"):
BLOB_BASE_PATH=
