GEMINI_API_KEY=
RESEND_API_KEY=

# Penyimpanan permanen lewat GITHUB REPO (menggantikan Vercel KV yang
# sudah dihapus) - tempat akun admin, log aktivitas, override data/foto
# siswa, dan foto galeri disimpan permanen (di-commit ke repo) saat
# deploy di Vercel.
#
# Cara dapatnya:
#   1. Buat Personal Access Token di GitHub -> Settings -> Developer
#      settings -> Fine-grained tokens (akses read+write "Contents" ke
#      repo tujuan), lalu isi di GITHUB_TOKEN.
#   2. Isi GITHUB_REPO dengan format "owner/nama-repo", mis.
#      azriel-ae/web-XI-TKJ1.
#
# PENTING: kalau repo yang dipakai di sini PUBLIC, semua data yang
# tersimpan (termasuk password hash akun admin & log aktivitas) bisa
# dibaca siapa saja lewat github.com. Pastikan repo-nya PRIVATE, atau
# pakai repo lain yang private khusus untuk penyimpanan data (boleh beda
# dari repo situs ini).
#
# Tanpa ini, data yang ditambah lewat panel /admin TIDAK akan tersimpan
# permanen saat di-deploy di Vercel.
GITHUB_TOKEN=
GITHUB_REPO=

# Opsional (kalau tidak diisi, default "main" dan "data-store"):
GITHUB_BRANCH=
GITHUB_DATA_PATH=

SESSION_SECRET=
